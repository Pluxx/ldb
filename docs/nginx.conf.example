# LDB behind nginx + PHP-FPM.
# Preferred: the document root is public/ — nothing outside it is reachable at all.
server {
    listen 443 ssl http2;
    server_name db.example.com;

    root /srv/ldb/public;
    index index.php;

    # Optional extra layer: restrict who can reach the login page at all.
    # allow 203.0.113.0/24;
    # deny all;

    client_max_body_size 64m;          # keep in line with upload_max / php.ini

    # Dotfiles (.htaccess, .git, .env …)
    location ~ /\. { deny all; return 404; }

    location = /api.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/api.php;
        fastcgi_param HTTPS on;        # lets LDB set Secure cookies / HSTS
        fastcgi_pass unix:/run/php/php-fpm.sock;
        fastcgi_read_timeout 600s;     # long imports/exports
        fastcgi_buffering off;         # stream exports
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }

    # Single sign-on links (docs/sso.md). Do not log query strings here if you use GET links:
    # access_log off;  (or a log_format without $request_uri / $args)
    location = /sso.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/sso.php;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }

    # No other PHP file exists in public/; never execute anything else.
    location ~ \.php$ { return 404; }

    location /assets/ {
        try_files $uri =404;
        expires 7d;
    }

    location / {
        try_files $uri /index.php;
    }
}

# Fallback: the whole repository is inside a web root (e.g. https://example.com/ldb/).
# Deny everything that is not public/ — equivalent to the root .htaccess rules.
#
# location ~ ^/ldb/(src|config|vendor|tests|resources|node_modules|bin|docker|docs)(/|$) { deny all; return 404; }
# location ~ ^/ldb/[^/]*\.(md|json|lock|dist|yml|yaml|xml|txt|sh|mjs)$ { deny all; return 404; }
# location ~ ^/ldb/(.*/)?\. { deny all; return 404; }
# location = /ldb/ { return 302 /ldb/public/; }
